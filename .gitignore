# ==============================================================================
# Model Checkpoints & Pretrained Weights (>100MB rejected by GitHub)
# ==============================================================================
models/**/*.pth
models/**/*.pt
models/**/*.bin
models/**/*.onnx
models/**/*.safetensors
eksperimen_model/checkpoints/**/*.pth
eksperimen_model/checkpoints/**/*.pt
*.pth
*.pt
*.ckpt

# Keep folder structures
!models/Point-MAE/.gitkeep
!eksperimen_model/checkpoints/**/.gitkeep

# ==============================================================================
# Datasets (Do NOT track raw radar files or huge databases in git)
# ==============================================================================
*.lmdb
*.lmdb-lock
datasets/MM-Fi Dataset/filtered_mmwave/
datasets/MM-Fi_features_*/
datasets/MM-Fi_extracted_features/*
datasets/MM-Fi_grounded_qa/*.jsonl
datasets/m4human/
derived_data/m4human/
derived/m4human/
datasets/**/*.bin
datasets/**/*.npy
datasets/**/*.npz
!datasets/**/.gitkeep
!datasets/**/MMFi_action_segments.csv
!datasets/**/qa_dataset_summary.json

# ==============================================================================
# Training Reports - Ignore Raw Large Prediction Dumps (>50-100MB)
# (Keeps all report.md, index, metrics, loss curves, and diagnostic JSON intact)
# ==============================================================================
docs/report_training/**/predictions_*.jsonl

# ==============================================================================
# Temporary / Scratch / IDE / OS Files
# ==============================================================================
scratch/
implementatoin plan backup/
*.tmp
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Antigravity / Agent logs
.system_generated/
